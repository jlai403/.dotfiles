[Thumbnailer Entry]
TryExec=bash
Exec=bash -c 'tmpdir=$(mktemp -d); if exiv2 -ep2 -l "$tmpdir" "$1" >/dev/null 2>&1; then preview=$(find "$tmpdir" -name "*-preview*.*" | head -1); if [ -n "$preview" ] && [ -f "$preview" ]; then magick "$preview" -thumbnail "$3" "$2" 2>/dev/null && { rm -rf "$tmpdir"; exit 0; }; fi; fi; rm -rf "$tmpdir"; magick "$1" -thumbnail "$3" "$2"' _ %i %o %s
MimeType=image/x-adobe-dng;image/x-canon-cr2;image/x-canon-cr3;image/x-dcraw;image/x-epson-erf;image/x-fuji-raf;image/x-kodak-dcr;image/x-kodak-k25;image/x-kodak-kdc;image/x-leaf-mos;image/x-mamiya-mef;image/x-minolta-mrw;image/x-nikon-nef;image/x-olympus-orf;image/x-panasonic-raw;image/x-panasonic-raw2;image/x-panasonic-rw2;image/x-pentax-pef;image/x-phaseone-iiq;image/x-samsung-srw;image/x-sigma-x3f;image/x-sony-arw;image/x-sony-sr2;image/x-sony-srf;
