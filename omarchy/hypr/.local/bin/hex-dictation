#!/usr/bin/env bash
# Hex voice dictation control — local shim while omarchy 4.0.6 predates the
# official option. Delete this (and the bindings.lua block) once
# Setup > Defaults > Dictation -> Hex exists; upstream's omarchy-dictation
# binds the same keys (Alt+Space toggle, Right Alt push-to-talk).

# Hex's control commands exit 3 when no Hex is running and never launch it.
not_running=3
no_speech=4

hex_state() {
  hex status 2>/dev/null | jq -r '.desktop.activity.state // empty'
}

start() {
  local result
  hex dictation start
  result=$?
  if (( result == not_running )); then
    hex start >/dev/null && hex dictation start
  else
    return "$result"
  fi
}

# Hex pastes with a bare Ctrl+V, which terminals ignore, so take the transcript
# and let omarchy-clipboard-paste-text type it into whatever is focused.
stop() {
  local text result
  if ! command -v hex >/dev/null || [[ $(hex_state) != "dictating" ]]; then
    return 0
  fi
  text=$(hex dictation stop --print)
  result=$?
  if (( result == 0 )); then
    omarchy-clipboard-paste-text "$text"
  elif (( result != no_speech )); then
    return "$result"
  fi
}

toggle() {
  if [[ $(hex_state) == "dictating" ]]; then stop; else start; fi
}

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  toggle) toggle ;;
  *) echo "Usage: hex-dictation <start|stop|toggle>" >&2; exit 1 ;;
esac
