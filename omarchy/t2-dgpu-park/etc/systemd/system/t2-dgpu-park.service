[Unit]
Description=Park the AMD dGPU off the PCIe bus (driverless device cannot power-manage itself)
ConditionPathExists=|/sys/bus/pci/devices/0000:03:00.0
ConditionPathExists=|/sys/bus/pci/devices/0000:03:00.1

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'for d in /sys/bus/pci/devices/0000:03:00.0 /sys/bus/pci/devices/0000:03:00.1; do [ -d "$d" ] && echo 1 > "$d/remove"; done'

[Install]
WantedBy=multi-user.target
