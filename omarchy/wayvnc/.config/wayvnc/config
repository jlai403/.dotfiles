# WayVNC — remote desktop for the Hyprland session.
#
# Binds all interfaces; ufw is the security boundary, not the bind address.
# A hardcoded tailnet IP used to live here, but wayvnc passes `address` straight
# to bind(2) with no name resolution, so every Tailscale reassignment left the
# unit failing to bind and restart-looping. Required firewall state:
#   sudo ufw allow in on tailscale0 to any port 5900 proto tcp
# with ufw's default-deny incoming policy denying 5900 everywhere else.
#
# Authentication is PAM (enable_pam), so there is no secret in this file; the
# package ships /etc/pam.d/wayvnc. The WireGuard transport encrypts the session,
# so no TLS certificate is needed.
#
# Connect from a VNC viewer over the tailnet, e.g. TigerVNC:
#   TigerVNC viewer -> <tailnet-ip>::5900   (auth: your Linux password)
address=0.0.0.0
port=5900
enable_pam=true
