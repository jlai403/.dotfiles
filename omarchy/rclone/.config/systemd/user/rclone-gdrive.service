[Unit]
Description=Google Drive mount (rclone)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/rclone mount gdrive: "%h/Google Drive" --vfs-cache-mode full --vfs-cache-max-size 20G --vfs-cache-max-age 24h --dir-cache-time 96h --poll-interval 15m
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target