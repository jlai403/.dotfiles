#!/usr/bin/env python3
"""Loopback proxy for opencode-quota's OpenCode Go provider.

OpenCode console accounts authenticate via OAuth (stored in opencode.db and
exposed to the CLI as OPENCODE_CONSOLE_TOKEN), not via auth.json, so the quota
plugin's built-in opencode-go provider cannot see them. The console usage
endpoint also requires an x-opencode-org-id header, which the plugin cannot
send. This proxy supplies both: it reads the account token and active org from
opencode's database and forwards to the real usage endpoint.

See opencode/.config/opencode/opencode-quota/quota-toast.jsonc (quotaProviders).
"""
import http.server
import json
import os
import sqlite3
import urllib.error
import urllib.request

UPSTREAM = "https://opencode.ai/inference/go/v1/usage"
DB = os.path.expanduser("~/.local/share/opencode/opencode.db")
PORT = int(os.environ.get("QUOTA_PROXY_PORT", "8788"))
USER_AGENT = (
    "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
    "(KHTML, like Gecko) Chrome/126.0 Safari/537.36"
)


def read_account():
    """Return (access_token, active_org_id) from opencode's DB, or (None, None)."""
    try:
        con = sqlite3.connect(f"file:{DB}?mode=ro", uri=True, timeout=2)
        try:
            token = con.execute("select access_token from account limit 1").fetchone()
            org = con.execute("select active_org_id from account_state limit 1").fetchone()
        finally:
            con.close()
        return (token[0] if token else None, org[0] if org else None)
    except sqlite3.Error:
        return (None, None)


class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def do_GET(self):
        db_token, org = read_account()
        token = db_token or self.headers.get("Authorization", "").removeprefix("Bearer ").strip()
        headers = {"Accept": "application/json", "User-Agent": USER_AGENT}
        if token:
            headers["Authorization"] = f"Bearer {token}"
        if org:
            headers["x-opencode-org-id"] = org
        req = urllib.request.Request(UPSTREAM, headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=20) as resp:
                body, status = resp.read(), resp.status
        except urllib.error.HTTPError as exc:
            body, status = exc.read(), exc.code
        except Exception as exc:  # noqa: BLE001
            body, status = json.dumps({"error": str(exc)}).encode(), 502
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args):
        pass


if __name__ == "__main__":
    http.server.HTTPServer(("127.0.0.1", PORT), Handler).serve_forever()
