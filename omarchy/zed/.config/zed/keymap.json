// Zed keymap (omarchy) — macOS parity.
//
// Generated from Zed v1.18.1 assets/keymaps/default-macos.json + macos/vscode.json,
// translating every `cmd`-chord to the chord Hyprland's Cmd shim actually delivers:
//   cmd-X        -> ctrl-X          (plain Cmd is shimmed to Ctrl)
//   cmd-shift-X  -> ctrl-shift-X    (X in the curated Cmd+Shift shim list)
//   cmd-shift-X  -> cmd-shift-X     (X not curated: passes through as Super)
//   cmd-alt-X    -> alt-cmd-X       (Cmd+Alt passes through)
//   ctrl-cmd-X   -> ctrl-cmd-X      (Cmd+Ctrl passes through)
// Cmd+arrow / Backspace / Delete chords are omitted: Hyprland's Cmd nav shim and
// the Option->Ctrl word-nav shim own those chords.
// Regenerate after a Zed upgrade. Edit the override block at the end only.
[
  {
    "bindings": {
      "ctrl-enter": "menu::SecondaryConfirm",
      "ctrl-escape": "menu::Cancel",
      "cmd-shift-w": "workspace::CloseWindow",
      "ctrl-o": "workspace::Open",
      "ctrl-=": [
        "zed::IncreaseBufferFontSize",
        {
          "persist": false
        }
      ],
      "ctrl-+": [
        "zed::IncreaseBufferFontSize",
        {
          "persist": false
        }
      ],
      "ctrl-": [
        "zed::DecreaseBufferFontSize",
        {
          "persist": false
        }
      ],
      "ctrl-0": [
        "zed::ResetBufferFontSize",
        {
          "persist": false
        }
      ],
      "alt-cmd-,": "zed::OpenSettingsFile",
      "ctrl-q": "zed::Quit",
      "ctrl-h": "zed::Hide",
