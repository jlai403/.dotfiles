# Package list consumed by main.zsh --apps (Brewfile equivalent).
# One package per line; blank lines and # comments are ignored.
# Installed via yay: official repo and AUR packages can be mixed
# (repo packages go through pacman's backend).
# Dev toolchains live in omarchy/mise, not here.

# Bootstrap toolchain
stow
go-task
yq
yay

# Shell
zsh
zsh-syntax-highlighting
zsh-autosuggestions
omarchy-zsh

# Hyper key daemon: hold CapsLock = Hyper (C-M-A), tap = Esc
keyd

# Apple T2 hardware: Touch Bar renderer (arch-mact2 repo; depends on linux-t2,
# already the running kernel). Drives the niraj-envision/touch-bar plugin.
tiny-dfr

# 3D printing (AUR): UltiMaker Cura slicer, wraps the official AppImage
cura-bin

# Google Drive FUSE mount (rclone)
rclone

# Remote desktop: VNC server for the wlroots/Hyprland session (Tailscale + PAM)
wayvnc

# Chat
discord
