# Shared Ghostty base (both OSes).
# Platform settings live in local.conf, stowed from macos/ghostty or
# omarchy/ghostty. Loaded last, so platform files can override anything here.

# Cursor
cursor-style = block

# Shell integration
shell-integration-features = no-cursor

# Send Shift+Enter as CSI-u so TUIs can distinguish it from Enter.
keybind = shift+enter=csi:13;2u
# Legacy encoding sends Alt+Shift+Enter the same as Alt+Enter; send CSI-u so tmux can match M-S-Enter.
keybind = alt+shift+enter=csi:13;4u

# Platform overrides
config-file = local.conf
