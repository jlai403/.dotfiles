[user]
	name = Joey Lai
	email = 3282127+jlai403@users.noreply.github.com
	signingKey = ~/.ssh/id_ed25519

[url "git@github.com:jlai403"]
	insteadOf = https://github.com/jlai403

[url "ssh://git@github.com/"]
	insteadOf = "gh:"

[url "ssh://git@ghjlai/jlai403/"]
	insteadOf = "ghjlai:"

[url "ssh://git@ghstellar/stellaralgo/"]
	insteadOf = "ghstellar:"

[url "ssh://git@forgejo/jlai/"]
	insteadOf = "forgejo:"

[init]
	defaultBranch = main

[status]
	branch = true
	showStash = true
	showUntrackedFiles = all

[core]
	compression = 9
	preloadindex = true

[diff]
	context = 3
	renames = copies
	interHunkContext = 10
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true

[pager]
	diff = delta

[delta]
	features = side-by-side
	whitespace = error

[push]
	autoSetupRemote = true
	default = current
	followTags = true

[pull]
	default = current
	rebase = true

[rebase]
	autostash = true
	missingCommitsCheck = warn

[log]
	abbrevCommit = true
	graphColors = blue,yellow,cyan,magenta,green,red

[color "decorate"]
	HEAD = red
	branch = blue
	tag = yellow
	remoteBranch = magenta

[color "branch"]
	current = magenta
	local = default
	remote = yellow
	upstream = green
	plain = blue

[branch]
	sort = -committerdate

[tag]
	sort = -version:refname

[pager]
	branch = false
	tag = false

[commit]
	verbose = true
	gpgsign = true

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

[column]
	ui = auto

[rerere]
	enabled = true
	autoupdate = true

[alias]
	co = checkout
	ci = commit
	br = branch
	st = status
	sweep = "!git branch --merged | grep -v ^\\* | grep -v main | grep -v master | xargs -r git branch -d"
	tidy = !~/.config/git/scripts/tidy
