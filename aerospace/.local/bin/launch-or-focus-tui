#!/bin/bash
# usage: launch-or-focus-tui <command> [<fallback-workspace>]
# If <command> is already running, focus its terminal window wherever it is.
# Otherwise switch to <fallback-workspace> (if given) and open one Ghostty window running <command>.
set -euo pipefail

cmd="${1:?usage: launch-or-focus-tui <command> [workspace]}"
fallback_ws="${2:-}"

pid="$(pgrep -x "$cmd" | head -1 || true)"
if [ -n "$pid" ]; then
    apid="$pid"
    while [ -n "$apid" ] && [ "$apid" -gt 1 ]; do
        comm="$(ps -o comm= -p "$apid" | tr -d ' ')"
        [[ "$comm" == *[Gg]hostty* ]] && break
        apid="$(ps -o ppid= -p "$apid" | tr -d ' ')"
    done
    line="$(aerospace list-windows --monitor all --pid "$apid" --format '%{window-id}|%{workspace}' | head -1 || true)"
    if [ -n "$line" ]; then
        ws="${line#*|}"
        wid="${line%%|*}"
        [ -n "$ws" ] && aerospace workspace "$ws"
        [ -n "$wid" ] && aerospace focus --window-id "$wid"
        exit 0
    fi
fi

[ -n "$fallback_ws" ] && aerospace workspace "$fallback_ws"
open -na Ghostty.app --args -e "$cmd"